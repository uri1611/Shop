# Archivo de la base SQLite (se crea en backend/prisma/dev.db)
DATABASE_URL="file:./dev.db"
PORT=3000

# Secreto para firmar los tokens JWT. Cualquier texto largo y aleatorio.
JWT_SECRET="reemplazar-con-un-secreto-local"

# Clave SECRETA de Stripe en modo TEST (empieza con sk_test_).
# Se saca de https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_reemplazar"

# Adónde vuelve Stripe después del pago.
FRONTEND_URL="http://localhost:5173"
